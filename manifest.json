{
  "manifest_version": 3,
  "name": "NovelAI-prompt-all-in-one",
  "description": "All-in-one prompt management, wildcards, and Danbooru autocomplete for NovelAI",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://image.novelai.net/*",
    "https://novelai.net/image*",
    "https://novelai.net/image/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://image.novelai.net/*",
        "https://novelai.net/image*",
        "https://novelai.net/image/*"
      ],
      "js": [
        "lib/runtime/lifecycle.js",
        "lib/storage/extension-storage.js",
        "lib/message-protocol.js",
        "lib/Sortable.umd.js",
        "lib/group-tags-data.js",
        "modules/history-favorites-panel.js",
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/runtime/lifecycle.js",
        "lib/injected/novelai-compat.js",
        "lib/injected/prompt-sync-controller.js",
        "lib/injected/prompt-storage-shim.js",
        "injector.js",
        "modules/auto-clicker.js",
        "data/dictionary.csv",
        "pages/popup.html",
        "pages/group-tags.html",
        "styles/manager-panel.css"
      ],
      "matches": [
        "https://novelai.net/*",
        "https://*.novelai.net/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
