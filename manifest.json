{
  "manifest_version": 3,
  "name": "NovelAI-prompt-all-in-one",
  "description": "All-in-one prompt management, wildcards, and Danbooru autocomplete for NovelAI",
  "version": "3.0.5",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://image.novelai.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.novelai.net/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injector.js",
        "auto-clicker.js",
        "dictionary.csv",
        "popup.html",
        "popup.js",
        "sync.html",
        "sync.js",
        "codemirror-bundle.js",
        "manager-panel.css",
        "worker.js",
        "default_wildcards/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}